    AP -- Cancelar --> RF
    EJ -- "paso fallido<br/>o no elegible" --> RF
    GE --> RF["5. Respuesta final<br/>explica éxito, rechazo o error"]
    RF --> FIN(["Respuesta en la interfaz"])
    EJ -.-> LOG[("Registro de acciones<br/>JSONL")]
