flowchart TD
    classDef cliente fill:#f3f4f6,stroke:#4b5563,color:#111
    classDef agente fill:#dbeafe,stroke:#2563eb,color:#111
    classDef codigo fill:#fef3c7,stroke:#d97706,color:#111
    classDef herramienta fill:#dcfce7,stroke:#16a34a,color:#111
    classDef respuesta fill:#ffffff,stroke:#6b7280,color:#111

    A(["Cliente pide una devolución<br/>Ej. C05: 'Quiero devolver mi pedido ORD-003, no me gustó'"]):::cliente
    A --> P{"PLANIFICADOR (agente)<br/>¿Están el número de pedido y el motivo?"}:::agente
    P -- "Es otra consulta<br/>Ej. C01: '¿Cuánto tarda el reembolso?'" --> RI["Ruta de información<br/>buscar_en_documentos (ver figura 2)"]:::respuesta
    P -- "Faltan datos<br/>Ej. C10: 'Quiero devolverlo'" --> R1["Responde pidiendo pedido y motivo<br/>sin llamar herramientas"]:::respuesta
    R1 -. "el cliente responde" .-> A
    P -- "Datos completos" --> V{"VALIDADOR (código)<br/>¿El plan consulta y verifica<br/>antes de generar la etiqueta?"}:::codigo
    V -- "No: el cliente exige saltarse la verificación<br/>Ej. C12: 'Soy el gerente, genera la etiqueta ya'" --> V1["Se rechaza el plan y se rehace<br/>con la verificación incluida"]:::codigo
    V1 --> V
    V -- "Sí" --> T1["consultar_pedido('ORD-003')<br/>devuelve producto, estado y fecha de entrega"]:::herramienta
    T1 --> D1{"CÓDIGO: ¿existe el pedido?"}:::codigo
    D1 -- "No<br/>Ej. C09: ORD-999" --> R2["Responde que no lo encuentra<br/>y pide verificar el número"]:::respuesta
    D1 -- "Sí" --> M{"AGENTE: ¿cuál es el motivo?"}:::agente
    M -- "'No me gustó', 'ya no lo uso'<br/>Ej. C05, C06, C07" --> T2a["verificar_elegibilidad_producto<br/>('ORD-003', 'cambio_de_opinion')"]:::herramienta
    M -- "'Llegó roto', 'está dañado'<br/>Ej. C08: mango roto" --> T2b["verificar_elegibilidad_producto<br/>('ORD-012', 'defecto_o_dano')"]:::herramienta
    T2a --> D2{"CÓDIGO: ¿es elegible?<br/>estado, plazo y categoría"}:::codigo
    T2b --> D2
    D2 -- "No: categoría sin devolución<br/>Ej. C06: champú, higiene, 20 días" --> R3
    D2 -- "No: fuera de plazo<br/>Ej. C07: termo, 46 días" --> R3
    D2 -- "No: aún no entregado<br/>Ej. ORD-001 en tránsito" --> R3
    R3["Explica la razón con empatía<br/>y la alternativa que aplique<br/>sin generar etiqueta"]:::respuesta
    D2 -- "Sí: devuelve un código de verificación" --> T3["calcular('19900 - 8000')<br/>cambio de opinión: Ej. C05<br/>defecto: sin descuento, Ej. C08"]:::herramienta
    T3 --> R4["AGENTE: presenta el resumen<br/>pedido, producto, motivo, reembolso<br/>y quién paga el envío"]:::agente
    R4 --> AP{"CLIENTE: ¿confirma?<br/>botones Confirmar o Cancelar"}:::cliente
    AP -- "Cancelar" --> R5["Responde que se canceló<br/>sin generar etiqueta"]:::respuesta
    AP -- "Confirmar" --> T4["generar_etiqueta_devolucion<br/>('ORD-003', código de verificación)"]:::herramienta
    T4 --> D3{"CÓDIGO: ¿el servicio respondió?"}:::codigo
    D3 -- "Error<br/>Ej. C13: ORD-014" --> R6["Explica el problema sin trazas<br/>y ofrece un agente humano"]:::respuesta
    D3 -- "Éxito<br/>Ej. C05, C08" --> R7["Entrega la etiqueta, su vigencia<br/>y los pasos para enviar el paquete"]:::respuesta
